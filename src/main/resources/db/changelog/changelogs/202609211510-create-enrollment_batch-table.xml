<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="202609211510" author="assistant">

        <createTable tableName="enrollment_batch">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_enrollment_batch" nullable="false"/>
            </column>

            <column name="enrollment_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_enrollment_batch_enrollment"
                             references="enrollment(id)"/>
            </column>

            <column name="student_id" type="VARCHAR(10)">
                <constraints nullable="false" foreignKeyName="fk_enrollment_batch_student"
                             references="student(student_id)"/>
            </column>

            <column name="course_id" type="VARCHAR(10)">
                <constraints foreignKeyName="fk_enrollment_batch_course" references="course(course_id)"/>
            </column>

            <column name="batch_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_enrollment_batch_batch"
                             references="class_batch(id)"/>
            </column>

            <column name="batch_name" type="VARCHAR(150)"/>

        </createTable>

    </changeSet>

</databaseChangeLog>
