<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="202609211508" author="assistant">

        <createTable tableName="class_schedule">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_class_schedule" nullable="false"/>
            </column>

            <column name="class_batch_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_class_schedule_batch"
                             references="class_batch(id)"/>
            </column>

            <column name="class_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="class_date" type="DATE"/>
            <column name="start_time" type="TIME"/>
            <column name="end_time" type="TIME"/>
            <column name="mode" type="VARCHAR(30)"/>
            <column name="status" type="VARCHAR(30)"/>

            <!-- Audit fields -->

            <column name="created_dt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_dt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="BIGINT"/>

        </createTable>

    </changeSet>

</databaseChangeLog>
