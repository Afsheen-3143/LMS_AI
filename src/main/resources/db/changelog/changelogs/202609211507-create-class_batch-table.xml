<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="202609211507" author="assistant">

        <createTable tableName="class_batch">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_class_batch" nullable="false"/>
            </column>

            <column name="course_id" type="VARCHAR(10)">
                <constraints nullable="false" foreignKeyName="fk_class_batch_course"
                             references="course(course_id)"/>
            </column>

            <column name="class_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>

            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="status" type="VARCHAR(30)"/>
            <column name="capacity" type="INT"/>

            <!-- Audit fields -->

            <column name="created_dt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_dt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="BIGINT"/>

        </createTable>

    </changeSet>

</databaseChangeLog>
