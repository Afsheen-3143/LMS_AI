<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="202609211505" author="assistant">

        <createTable tableName="course_fee_setting">

            <column name="course_id" type="VARCHAR(10)">
                <constraints primaryKey="true" primaryKeyName="pk_course_fee_setting" nullable="false"
                             foreignKeyName="fk_course_fee_setting_course" references="course(course_id)"/>
            </column>

            <column name="course_duration" type="VARCHAR(50)"/>
            <column name="fee" type="DECIMAL(12,2)"/>
            <column name="discount" type="DECIMAL(12,2)"/>

        </createTable>

    </changeSet>

</databaseChangeLog>
