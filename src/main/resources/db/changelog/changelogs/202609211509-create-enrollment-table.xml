<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="202609211509" author="assistant">

        <createTable tableName="enrollment">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_enrollment" nullable="false"/>
            </column>

            <column name="student_id" type="VARCHAR(10)">
                <constraints nullable="false" foreignKeyName="fk_enrollment_student"
                             references="student(student_id)"/>
            </column>

            <column name="course_id" type="VARCHAR(10)">
                <constraints foreignKeyName="fk_enrollment_course" references="course(course_id)"/>
            </column>

            <column name="course_title" type="VARCHAR(200)"/>

            <column name="program_id" type="VARCHAR(10)">
                <constraints foreignKeyName="fk_enrollment_program" references="program(program_id)"/>
            </column>

            <column name="status" type="VARCHAR(30)"/>
            <column name="payment_status" type="VARCHAR(30)"/>

            <!-- Audit fields -->

            <column name="created_dt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_dt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="BIGINT"/>

        </createTable>

    </changeSet>

</databaseChangeLog>
