<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="202609211502" author="assistant">

        <createTable tableName="course">

            <column name="course_id" type="VARCHAR(10)">
                <constraints primaryKey="true" primaryKeyName="pk_course" nullable="false"/>
            </column>

            <column name="course_title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="subject_nm" type="VARCHAR(100)"/>
            <column name="description" type="CLOB"/>
            <column name="language" type="VARCHAR(50)"/>
            <column name="level" type="VARCHAR(30)"/>
            <column name="skills" type="VARCHAR(500)"/>

            <!-- Audit fields -->

            <column name="created_dt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="created_by" type="BIGINT"/>
            <column name="updated_dt" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_by" type="BIGINT"/>

        </createTable>

    </changeSet>

</databaseChangeLog>
